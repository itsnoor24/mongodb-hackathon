{
  "name": "sentinel",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "setup": "npm run setup -w api",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w api\" \"npm run dev -w web\"",
    "build": "npm run build -w api && npm run build -w web",
    "seed": "npm run seed -w api",
    "verify-atlas": "npm run verify-atlas -w api",
    "verify-demo": "npm run verify-demo -w api",
    "consume-text": "npm run consume-text -w api --",
    "demo:text": "npm run demo:text -w api --",
    "demo:conversation": "npm run demo:conversation -w api --",
    "demo:parsed": "npm run demo:parsed -w api --",
    "demo:pipeline": "npm run demo:pipeline -w api --",
    "nodes:embed": "npm run nodes:embed -w api --",
    "test:streams": "npm run test:streams -w api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
