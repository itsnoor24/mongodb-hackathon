# MongoDB Atlas (organizer sandbox)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sentinel

# API
PORT=3001

# Demo identities
DEMO_RUN_ID=demo-run-001
DEMO_AGENT_ID=demo-agent-001
SENTINEL_AGENT_KEY=demo-agent-key-change-me
SENTINEL_REVIEWER_KEY=demo-reviewer-key-change-me

# GitHub demo (private repo only — token stays server-side)
GITHUB_TOKEN=
GITHUB_DEMO_OWNER=
GITHUB_DEMO_REPO=
GITHUB_ALLOWED_OWNER=

# Optional model adapter (defaults to deterministic replay)
MODEL_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend (Vite)
VITE_REVIEWER_KEY=demo-reviewer-key-change-me