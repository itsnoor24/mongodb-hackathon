MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sentinel
PORT=3001
DEMO_RUN_ID=demo-run-001
DEMO_AGENT_ID=demo-agent-001
SENTINEL_AGENT_KEY=demo-agent-key-change-me
SENTINEL_REVIEWER_KEY=demo-reviewer-key-change-me
GITHUB_TOKEN=
GITHUB_DEMO_OWNER=
GITHUB_DEMO_REPO=
GITHUB_ALLOWED_OWNER=
GITHUB_REQUIRE_PRIVATE=true
MODEL_PROVIDER=deterministic

# Optional local text-stream parser. Leave model blank for raw capture only.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Atlas managed automated embedding; no separate Voyage API key required.
NODE_EMBEDDING_MODEL=voyage-4-lite
NODE_EMBEDDING_INDEX=stream_nodes_semantic

# Shared semantic-monitor query queue. Default is conservative for free clusters.
BEHAVIOR_SEMANTIC_INTERVAL_MS=22000
